<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>THE SAME HOUSE</title>
<style>
  :root{
    --yellow:#c9a227;
    --yellow-dim:#7a6318;
    --yellow-bright:#e8c34a;
    --bg:#08060a;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent; user-select:none;}
  html,body{
    margin:0; padding:0; width:100%; height:100%;
    background:var(--bg); overflow:hidden;
    font-family: Georgia, 'Times New Roman', serif;
  }
  #gameCanvas{
    position:fixed; inset:0; z-index:1; touch-action:none; cursor:crosshair;
  }
  #gameCanvas canvas{ display:block; width:100%; height:100%; }

  /* ---------- overlays ---------- */
  .screen{
    position:fixed; inset:0; display:flex; flex-direction:column;
    align-items:center; justify-content:center; text-align:center;
    padding:6vw;
    background:radial-gradient(ellipse at center, rgba(20,16,4,0.96), rgba(2,2,2,0.99));
    color:#d8c98a; z-index:50;
  }
  .hidden{display:none !important;}
  .title{
    font-size:clamp(28px,7vw,58px);
    letter-spacing:0.04em;
    color:var(--yellow-bright);
    text-shadow:0 0 18px rgba(232,195,74,0.35), 0 0 2px #000;
    margin:0 0 6px 0;
    font-weight:normal;
  }
  .subtitle{
    font-size:clamp(12px,2.6vw,15px);
    color:#8a7a4a; letter-spacing:0.08em; margin-bottom:34px;
    max-width:520px; line-height:1.7; font-style:italic;
  }
  .lore{
    max-width:480px; font-size:clamp(12px,2.4vw,14px); line-height:1.8;
    color:#a99a67; margin-bottom:30px;
  }
  button.playbtn{
    font-family:inherit; font-size:clamp(14px,3vw,17px);
    background:transparent; color:var(--yellow-bright);
    border:1px solid var(--yellow-dim); padding:14px 38px;
    letter-spacing:0.12em; cursor:pointer; border-radius:2px;
    transition:background .3s, color .3s, box-shadow .3s;
  }
  button.playbtn:hover{
    background:rgba(201,162,39,0.12);
    box-shadow:0 0 22px rgba(201,162,39,0.25);
  }
  .stat{color:#6b5d38; font-size:12px; margin-top:22px; letter-spacing:0.06em;}

  /* ---------- hud ---------- */
  #hud{
    position:fixed; left:0; right:0; bottom:0; top:0; pointer-events:none; z-index:20;
  }
  #doorsCount{
    position:absolute; left:18px; bottom:16px; color:rgba(201,162,39,0.65);
    font-size:13px; letter-spacing:0.08em;
  }
  #whisper{
    position:absolute; top:12%; left:50%; transform:translateX(-50%);
    color:rgba(216,201,138,0); font-size:clamp(14px,2.6vw,18px);
    letter-spacing:0.1em; text-align:center; max-width:80vw;
    transition:color 1s ease, opacity 1s ease; font-style:italic; text-shadow:0 0 10px #000;
  }
  #prompt{
    position:absolute; left:50%; bottom:20%; transform:translateX(-50%);
    color:rgba(232,195,74,0); font-size:clamp(12px,2.4vw,15px);
    letter-spacing:0.15em; font-weight: bold; text-shadow: 0 2px 4px #000;
  }
  #crosshair{
    position:absolute; left:50%; top:50%; width:6px; height:6px;
    margin:-3px 0 0 -3px; border-radius:50%;
    background:rgba(232,195,74,0.6);
  }
  #muteBtn{
    position:absolute; top:14px; right:16px; pointer-events:auto;
    background:transparent; border:1px solid rgba(201,162,39,0.3);
    color:rgba(201,162,39,0.6); font-family:inherit; font-size:11px;
    padding:6px 10px; letter-spacing:0.08em; cursor:pointer; border-radius:2px;
  }

  /* ---------- touch controls ---------- */
  #pad{
    position:fixed; left:18px; bottom:18px; width:130px; height:130px;
    display:grid; grid-template-columns:1fr 1fr 1fr; grid-template-rows:1fr 1fr 1fr;
    z-index:30; opacity:0.4;
  }
  #pad button{
    background:rgba(201,162,39,0.08); border:1px solid rgba(201,162,39,0.25);
    color:var(--yellow); font-size:16px; touch-action:none;
  }
  #pad button:active{background:rgba(201,162,39,0.25);}
  .p-up{grid-column:2; grid-row:1;}
  .p-left{grid-column:1; grid-row:2;}
  .p-right{grid-column:3; grid-row:2;}
  .p-down{grid-column:2; grid-row:3;}

  #vignette{
    position:fixed; inset:0; pointer-events:none; z-index:15;
    background:radial-gradient(ellipse at center, rgba(0,0,0,0) 20%, rgba(0,0,0,0.9) 100%);
  }
  #flash{
    position:fixed; inset:0; pointer-events:none; z-index:60;
    background:#fff; opacity:0; transition: opacity 0.1s ease-out;
  }
  #grain{
    position:fixed; inset:0; pointer-events:none; z-index:16; opacity:0.07;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://w3.org' width='100' height='100'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }

  @media (hover:hover) and (pointer:fine){ #pad{display:none;} }
</style>
</head>
<body>

<div id="gameCanvas"></div>
<div id="vignette"></div>
<div id="grain"></div>
<div id="flash"></div>

<div id="hud" class="hidden">
  <div id="crosshair"></div>
  <div id="whisper"></div>
  <div id="prompt"></div>
  <div id="doorsCount">Rooms Cleared: 0 / 7</div>
  <button id="muteBtn">SOUND: ON</button>
</div>

<div id="pad" class="hidden">
  <button class="p-up" data-k="up">▲</button>
  <button class="p-left" data-k="left">◀</button>
  <button class="p-right" data-k="right">▶</button>
  <button class="p-down" data-k="down">▼</button>
</div>

<div id="startScreen" class="screen">
  <h1 class="title">THE SAME HOUSE</h1>
  <div class="subtitle">every door leads to a house identical to the last</div>
  <div class="lore">You don't remember walking in. The light is always the same sick yellow,
  the furniture always almost where you left it. Four doors. Only one goes forward.
  Something else lives in the repetition with you.</div>
  <button class="playbtn" id="startBtn">STEP INSIDE</button>
  <div class="stat">WASD / Arrows to move · Move mouse to look (No clicking required) · Mobile: Drag screen to look</div>
</div>

<div id="deathScreen" class="screen hidden">
  <h1 class="title" style="color:#a33; text-shadow:0 0 18px rgba(200,30,30,0.5);">IT FOUND YOU</h1>
  <div class="lore" id="deathLine">The architecture looped. You chose incorrectly, and it caught your scent.</div>
  <div class="stat" id="deathStat">Rooms survived: 0</div>
  <button class="playbtn" id="retryBtn">WAKE UP AGAIN</button>
</div>

<div id="winScreen" class="screen hidden">
  <h1 class="title" style="color:#eee; text-shadow:0 0 24px rgba(255,255,255,0.6);">OUTSIDE</h1>
  <div class="lore" id="winLine">The air is cold. Real. You step into the crisp morning fog, never looking back.</div>
  <div class="stat" id="winStat">You escaped the infinite cycle.</div>
  <button class="playbtn" id="againBtn">GO BACK IN</button>
</div>

<script src="https://cloudflare.com"></script>
<script>
(function(){
"use strict";

/* ===================== THREE.JS SETUP ===================== */
const container = document.getElementById('gameCanvas');
const scene = new THREE.Scene();
scene.fog = new THREE.FogExp2(0x0a0805, 0.08);

const camera = new THREE.PerspectiveCamera(70, window.innerWidth/window.innerHeight, 0.1, 50);
const EYE_H = 1.6;
camera.position.set(0, EYE_H, 0);
camera.rotation.order = 'YXZ';

const renderer = new THREE.WebGLRenderer({ antialias:true });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(window.innerWidth, window.innerHeight);
container.appendChild(renderer.domElement);

const ambient = new THREE.AmbientLight(0x221a0f, 0.6);
scene.add(ambient);

const bulb = new THREE.PointLight(0xffd573, 1.2, 12);
bulb.position.set(0, 3.2, 0);
scene.add(bulb);

/* ===================== MATERIALS & GEOMETRY ===================== */
const wallMat = new THREE.MeshStandardMaterial({ color:0x54431b, roughness:0.8, metalness:0.1 });
const floorMat = new THREE.MeshStandardMaterial({ color:0x2b200d, roughness:0.6 });
const ceilMat = new THREE.MeshStandardMaterial({ color:0x3d3116, roughness:0.9 });
const doorMat = new THREE.MeshStandardMaterial({ color:0x1f1405, roughness:0.5 });
const handleMat = new THREE.MeshStandardMaterial({ color:0xd9b441, roughness:0.3, metalness:0.8 });
const monsterMat = new THREE.MeshBasicMaterial({ color:0x000000 });

const ROOM_SIZE = 8;
const HALF_ROOM = ROOM_SIZE / 2;

function buildRoom() {
  const roomGroup = new THREE.Group();

  const floorGeo = new THREE.PlaneGeometry(ROOM_SIZE, ROOM_SIZE);
  const floor = new THREE.Mesh(floorGeo, floorMat);
  floor.rotation.x = -Math.PI / 2;
  roomGroup.add(floor);

  const ceilGeo = new THREE.PlaneGeometry(ROOM_SIZE, ROOM_SIZE);
  const ceil = new THREE.Mesh(ceilGeo, ceilMat);
  ceil.rotation.x = Math.PI / 2;
  ceil.position.y = 3.5;
  roomGroup.add(ceil);

  const wallPanelGeo = new THREE.PlaneGeometry(3, 3.5);
  const topPanelGeo = new THREE.PlaneGeometry(2, 1.1);

  for(let i=0; i<4; i++) {
    const wallGroup = new THREE.Group();
    
    const leftP = new THREE.Mesh(wallPanelGeo, wallMat);
    leftP.position.set(-2.5, 1.75, 0);
    
    const rightP = new THREE.Mesh(wallPanelGeo, wallMat);
    rightP.position.set(2.5, 1.75, 0);

    const topP = new THREE.Mesh(topPanelGeo, wallMat);
    topP.position.set(0, 2.95, 0);

    wallGroup.add(leftP, rightP, topP);
    wallGroup.rotation.y = -i * Math.PI / 2;
    wallGroup.position.x = Math.sin(i * Math.PI / 2) * HALF_ROOM;
    wallGroup.position.z = -Math.cos(i * Math.PI / 2) * HALF_ROOM;

    roomGroup.add(wallGroup);
  }
  scene.add(roomGroup);
}

/* ===================== DOORS GENERATION ===================== */
let doors = [];
const doorInteractables = [];

function spawnDoors(correctIndex) {
  doors.forEach(d => scene.remove(d.mesh));
  doors = [];
  doorInteractables.length = 0;

  for(let i=0; i<4; i++) {
    const doorContainer = new THREE.Group();

    const doorFrame = new THREE.Mesh(new THREE.BoxGeometry(1.9, 2.4, 0.1), doorMat);
    doorFrame.position.y = 1.2;
    doorContainer.add(doorFrame);

    const knob = new THREE.Mesh(new THREE.SphereGeometry(0.06, 8, 8), handleMat);
